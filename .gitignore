# Claude Code internals — session data, caches, runtime state
backups/
cache/
debug/
downloads/
file-history/
history.jsonl
ide/
mcp-needs-auth-cache.json
paste-cache/
plugins/
projects/
sessions/
shell-snapshots/
statsig/
todos/

# Credentials — never commit
.credentials.json

# Sounds — regenerated by setup.ps1 from Windows Media
sounds/

# Telemetry runtime state — regenerated each session
telemetry/sessions/
telemetry/reports/
telemetry/current-session.json
telemetry/cumulative.json
telemetry/rolling-averages.json
telemetry/permission-log.jsonl
telemetry/cost-ledger.jsonl

# Daemon runtime state
daemon.lock
daemon.log
daemon.status.json
daemon/
daemon-auth-cooldown
daemon-auth-status.json

# Session/job runtime
session-env/
tasks/
jobs/
.last-cleanup
.last-update-result.json

# Local overrides — machine-specific
settings.local.json
terminal.local.lua

# Launcher / workspace runtime state — machine-specific, leaks cwd & repo names
repos.json
session.json
workspaces/active.json
workspaces/attention/
workspaces/pane-sessions/
workspaces/.last-ding-permission
workspaces/.last-ding-stop

# Per-session telemetry state + run flags — regenerated each session, leak session ids
telemetry/state-*.json
telemetry/running.flag
telemetry/running-*.flag

# Generated by Claude Code, hardcodes a machine-specific exe path
chrome/

# Test run cache
tests/.last-results.txt
tests/.last-results-pathlink.txt

# Session planning artifacts — transient, per-session working docs
plans/

# tiktok-sync scheduled run logs (runtime state)
logs/

# the private fleet docs moved out of this repo (2026-10-31): they live at $FLEET_DOCS (default D:/repo/docs)

# Runtime output of scripts/ (lint reports) and bytecode
state/
__pycache__/

node_modules/

# claude.ai synced skills: local copies, never published (agent-consolidation M0)
skills/synced/
