{
  "_comment": "macOS counterpart of settings.json. Same behaviour, with the PowerShell hooks and status line replaced by their python3 ports and $USERPROFILE replaced by $HOME. setup.sh installs this as ~/.claude/settings.json.",
  "env": {
    "BROWSER": "open"
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebSearch",
      "WebFetch",
      "Skill(remember)",
      "Skill(schedule)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/startup-reminder.py\"",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/record-pane-session.py\"",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/workspace-state.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/improve/audit.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/log-prompt.py\"",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "printf '%s' 'CONTRACT — you are writing for an executive stakeholder. Two things, nothing else:' '' 'OPEN: the asks as bullets. One line each. No nested plan unless a reading is' '      ambiguous and the ambiguity changes the work.' '' 'CLOSE: accomplished · remains — and remains DOUBLES AS next, so do not split them.' '       HEADLINES: one per bullet, under 110 chars. Nest short lines for detail;' '       never a paragraph wearing a dash.' '       A TOPIC EMOJI leads each bullet — the close is SCANNED, not read. No legend;' '       the emoji relates to that bullet own subject.' '       A caveat appears only if it changes a decision, and carries its fix.' '' 'BREVITY IS THE CONTRACT. They will ask for detail; do not pre-empt it. Detail' 'belongs in a file — give the path, not the paragraph.' '' 'NEVER a bare identifier. Say what the thing IS, not its index.' 'EXTEND before creating. VERIFY end to end before claiming.' 'ACT, do not ask. Naming a next step does not end the turn — do it.'",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/notify-attention.py\" --reason stop --silent",
            "shell": "bash",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/analyze-session.py\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/log-tool-done.py\"",
            "shell": "bash",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/check-terminal-config.py\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/record-compact.py\"",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/log-permission.py\"",
            "shell": "bash",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/telemetry/notify-attention.py\" --reason permission --sound ding-half",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/statusline.py\"",
    "padding": 1
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "stripe@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
